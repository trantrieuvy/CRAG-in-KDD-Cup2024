### Analyse the RAG results
df_results = pd.read_json("llama3.3_70b_predictions_new_prompts_task2.jsonl", lines=True)
print(df_results.shape)
df_results.head()
# Merge the two dataframes on the query column
df_merged = pd.merge(df_results, df, on='query')
print(df_merged.shape)
df_merged.head()
# Split df_merged to dataframe based on domain
df_merged_domain = df_merged.groupby('domain')
# Export each group to a jsonl file with only 'query', 'ground_truth', 'prediction' columns
for name, group in df_merged_domain:
    group[['query', 'ground_truth', 'prediction']].to_json(f"{name}_predictions.jsonl", orient='records', lines=True)
### "I don't know" answers
